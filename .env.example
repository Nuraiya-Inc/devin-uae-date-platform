# =============================================================
# NCPD Partner Network — environment variables
# Copy to .env and fill in. NEVER commit .env to git.
# =============================================================

# --- Core ----------------------------------------------------
# Postgres connection string. In Coolify, create a managed Postgres
# resource for this app and paste its internal connection string here.
DATABASE_URL="postgresql://ncpd:CHANGE_ME@localhost:5432/ncpd?schema=public"

# Public-facing URL of this app. No trailing slash. https in production.
# Production: https://ncpd.safabioworks.com
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# 32+ char random string. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_openssl_rand_base64_32"
AUTH_SECRET="CHANGE_ME_same_as_NEXTAUTH_SECRET"

# --- Anthropic -----------------------------------------------
# From https://console.anthropic.com — starts sk-ant-
ANTHROPIC_API_KEY="sk-ant-CHANGE_ME"

# Default model for agents (each agent spec may override).
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- OpenAI (voice-to-chat transcription only) ---------------
# Optional. Powers the microphone button in chat (voice notes) via Whisper.
OPENAI_API_KEY=""

# --- Branding ------------------------------------------------
APP_NAME="NCPD Partner Network"

# --- First-deploy seed --------------------------------------
# Used by `npm run db:seed`. Rotate passwords after first login.
SEED_CEO_EMAIL="nima.vakili@kmigroup.com"
SEED_CEO_NAME="Nima Vakili"
SEED_CEO_PASSWORD="CHANGE_ME_min_8_chars"
# Optional: NCPD demo official + demo partner logins (default to derived
# values from SEED_CEO_PASSWORD: "<pw>-ncpd" and "<pw>-farm").
SEED_STAFF_PASSWORD=""
SEED_PARTNER_PASSWORD=""

# --- Cron ----------------------------------------------------
# Bearer token for cron endpoints. Generate: openssl rand -base64 24
CRON_SECRET=""

# --- WhatsApp via Twilio (Sprint 3 — leave blank for web-only demo) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""        # whatsapp:+9665xxxxxxxx in prod
WHATSAPP_WEBHOOK_URL=""        # https://ncpd.safabioworks.com/api/whatsapp/inbound
WHATSAPP_SKIP_SIGNATURE_CHECK=""
