    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "docx": "^9.0.2",
    "exceljs": "^4.4.0",
    "google-auth-library": "^9.15.0",
    "googleapis": "^144.0.0",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.8.0",
    "next": "^15.5.0",
    "next-auth": "5.0.0-beta.25",
