{
  "name": "safa-platform",
  "version": "0.1.0",
  "private": true,
  "description": "UAE Palm Network — partner-facing multi-agent platform for the UAE date-palm ecosystem: AI agents with bounded tools, human-in-the-loop approvals, and an immutable audit log.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
